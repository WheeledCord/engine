               (SCRIPT_NONE))
SCRIPT_BINDING(think_after, "think-after", SCRIPT_NONE, "run think again after so many seconds",
               (SCRIPT_NONE, SCRIPT_FLOAT))

// ---- an entity's own fields
SCRIPT_BINDING(get_number, "get", SCRIPT_FLOAT, "read a number field of this entity",
