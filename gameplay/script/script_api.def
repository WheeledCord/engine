SCRIPT_BINDING(look_at, "look-at!", SCRIPT_BOOL, "face a point", (SCRIPT_NONE, SCRIPT_VECTOR2))
SCRIPT_BINDING(interpolated, "interpolated", SCRIPT_VECTOR2,
