/* The binding table: one row per call a script can make. Included several times, each time with
   SCRIPT_BINDING defined to emit something different — the C prototypes, the table itself, and the
   Scheme frontend's registration. These are free-standing calls; engine objects -- entities,
   cameras, timers and the rest -- are reached through their own properties and methods, which
   their types declare (core/object.h).

   SCRIPT_BINDING(identifier, script name, result type, help, (SCRIPT_NONE, argument types...))

   The argument types come as one parenthesised list that always begins with SCRIPT_NONE, because
   C99 cannot pass an empty one. The sentinel is dropped when the table is built. */

// ---- talking to the engine
SCRIPT_BINDING(log, "log", SCRIPT_NONE, "print a line to the terminal",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(rgba, "rgba", SCRIPT_INT, "pack a colour from r g b a, each 0 to 255",
               (SCRIPT_NONE, SCRIPT_INT, SCRIPT_INT, SCRIPT_INT, SCRIPT_INT))

// ---- declaring entity classes, which is how a script becomes a thing in the world
SCRIPT_BINDING(class_new, "class-new", SCRIPT_BOOL, "start declaring an entity class",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(class_field, "class-field", SCRIPT_BOOL,
               "add a field to a class: class name, field name, and float vector2 bool or int",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_STRING, SCRIPT_STRING))
SCRIPT_BINDING(class_on, "class-on", SCRIPT_BOOL,
               "name the function for an event: class name, spawn think draw or destroy, function",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_STRING, SCRIPT_STRING))
SCRIPT_BINDING(class_done, "class-done", SCRIPT_BOOL, "register the finished class with the world",
               (SCRIPT_NONE, SCRIPT_STRING))

// ---- entities
SCRIPT_BINDING(self, "self", SCRIPT_OBJECT, "the entity whose callback is running", (SCRIPT_NONE))
SCRIPT_BINDING(spawn, "spawn", SCRIPT_OBJECT, "spawn a class at a position; #f when it cannot",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_VECTOR2))
SCRIPT_BINDING(find_first, "find-first", SCRIPT_OBJECT, "the first living entity of a class, or #f",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(find_next, "find-next", SCRIPT_OBJECT,
               "the next living entity of a class after an entity, or #f",
               (SCRIPT_NONE, SCRIPT_OBJECT, SCRIPT_STRING))

// ---- input
SCRIPT_BINDING(input_vector, "input-vector", SCRIPT_VECTOR2,
               "movement from WASD and the arrow keys, never longer than one", (SCRIPT_NONE))
SCRIPT_BINDING(key_down, "key-down?", SCRIPT_BOOL, "is a key held", (SCRIPT_NONE, SCRIPT_INT))
SCRIPT_BINDING(key_pressed, "key-pressed?", SCRIPT_BOOL, "was a key pressed this step",
               (SCRIPT_NONE, SCRIPT_INT))
SCRIPT_BINDING(key_code, "key", SCRIPT_INT, "the code for a key named w or left or space",
               (SCRIPT_NONE, SCRIPT_STRING))

// ---- small math and queries a game callback keeps reaching for -----------------------------------
SCRIPT_BINDING(random_int, "random-int", SCRIPT_INT, "a random integer from min to max, inclusive",
               (SCRIPT_NONE, SCRIPT_INT, SCRIPT_INT))
SCRIPT_BINDING(vec_length, "vec-length", SCRIPT_FLOAT, "how long a vector is", (SCRIPT_NONE, SCRIPT_VECTOR2))
SCRIPT_BINDING(vec_distance, "vec-distance", SCRIPT_FLOAT, "how far apart two points are",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2))
SCRIPT_BINDING(vec_normalize, "vec-normalize", SCRIPT_VECTOR2, "a vector of length one, same direction",
               (SCRIPT_NONE, SCRIPT_VECTOR2))
SCRIPT_BINDING(sprite_size, "sprite-size", SCRIPT_VECTOR2, "one frame of a named sprite sheet, in pixels",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(text_width, "text-width", SCRIPT_INT, "how wide drawn text would be, in pixels",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_INT))

// ---- time
SCRIPT_BINDING(step, "dt", SCRIPT_FLOAT, "how long one simulation step is", (SCRIPT_NONE))
SCRIPT_BINDING(now, "now", SCRIPT_FLOAT, "gameplay time in seconds", (SCRIPT_NONE))
SCRIPT_BINDING(elapsed, "elapsed", SCRIPT_FLOAT,
               "seconds since this entity last thought, or spawned; for timing work done less than every step",
               (SCRIPT_NONE))
SCRIPT_BINDING(alpha, "alpha", SCRIPT_FLOAT, "how far between steps this frame is drawing",
               (SCRIPT_NONE))

// ---- drawing, for what a draw callback would reasonably do
SCRIPT_BINDING(draw_rect, "draw-rect", SCRIPT_NONE, "a rectangle from centre, size and colour",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_INT))
SCRIPT_BINDING(draw_rect_rotated, "draw-rect-rotated", SCRIPT_NONE,
               "a rectangle from centre, size, radians and colour",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_FLOAT, SCRIPT_INT))
/* The isometric grid in core/iso_grid.h. A script placing anything on one of these maps needs the
   same answers the C beside it gets, and these are the grid's own -- no map size, no camera and
   nothing about what a project considers passable, which stay with the project. */
SCRIPT_BINDING(hex_world, "hex-world", SCRIPT_VECTOR2, "where a hex sits, in world coordinates",
               (SCRIPT_NONE, SCRIPT_VECTOR2))
SCRIPT_BINDING(hex_at, "hex-at", SCRIPT_VECTOR2, "the hex a world point falls in",
               (SCRIPT_NONE, SCRIPT_VECTOR2))
SCRIPT_BINDING(hex_distance, "hex-distance", SCRIPT_INT, "steps across the grid between two hexes",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2))
SCRIPT_BINDING(hex_neighbour, "hex-neighbour", SCRIPT_VECTOR2, "the hex one step in a direction",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_INT))
SCRIPT_BINDING(hex_facing, "hex-facing", SCRIPT_INT, "which of the six views faces one hex to another",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2))
/* A sheet named the way a sound is: loaded once, kept, and drawn standing on the point given, by
   the ground anchor the sheet itself records. The time is playback time, so a script animates by
   handing over how long it has been going rather than by counting frames. */
SCRIPT_BINDING(draw_sprite, "draw-sprite", SCRIPT_BOOL,
               "a named sprite sheet, standing on a point, at a time in its playback",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_VECTOR2, SCRIPT_FLOAT))
SCRIPT_BINDING(draw_circle, "draw-circle", SCRIPT_NONE, "a circle from centre, radius and colour",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_FLOAT, SCRIPT_INT))
SCRIPT_BINDING(draw_line, "draw-line", SCRIPT_NONE, "a line from one point to another, in a colour",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_INT))
SCRIPT_BINDING(draw_triangle, "draw-triangle", SCRIPT_NONE, "a triangle from three points and a colour",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_INT))
SCRIPT_BINDING(draw_text, "draw-text", SCRIPT_NONE, "text at a position, in a size and colour",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_VECTOR2, SCRIPT_INT, SCRIPT_INT))

// ---- mouse state
SCRIPT_BINDING(mouse_position, "mouse-position", SCRIPT_VECTOR2, "the mouse position in pixels",
               (SCRIPT_NONE))
SCRIPT_BINDING(mouse_delta, "mouse-delta", SCRIPT_VECTOR2, "the mouse movement this step",
               (SCRIPT_NONE))
SCRIPT_BINDING(mouse_wheel, "mouse-wheel", SCRIPT_FLOAT, "the scroll wheel this step",
               (SCRIPT_NONE))
SCRIPT_BINDING(mouse_down, "mouse-down?", SCRIPT_BOOL, "is a mouse button held",
               (SCRIPT_NONE, SCRIPT_INT))
SCRIPT_BINDING(mouse_pressed, "mouse-pressed?", SCRIPT_BOOL, "was a mouse button pressed this step",
               (SCRIPT_NONE, SCRIPT_INT))

// ---- sound and scenes
SCRIPT_BINDING(play_sound, "play-sound", SCRIPT_BOOL, "play a sound file once",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(load_scene, "load-scene", SCRIPT_BOOL,
               "replace the world with a scene, once this callback has finished",
               (SCRIPT_NONE, SCRIPT_STRING))

// ---- saved key/values
SCRIPT_BINDING(save_set_number, "save-set-number!", SCRIPT_BOOL, "remember a number under a key",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_FLOAT))
SCRIPT_BINDING(save_set_string, "save-set-string!", SCRIPT_BOOL, "remember text under a key",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_STRING))
SCRIPT_BINDING(save_get_number, "save-get-number", SCRIPT_FLOAT,
               "the number under a key, 0 when there is none", (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(save_get_string, "save-get-string", SCRIPT_STRING,
               "the text under a key, empty when there is none", (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(save_write, "save-write", SCRIPT_BOOL, "write every pair to a file, all or nothing",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(save_read, "save-read", SCRIPT_BOOL, "replace the pairs with a file's contents",
               (SCRIPT_NONE, SCRIPT_STRING))

// ---- debug drawing, for what a script wants to see while it runs
SCRIPT_BINDING(debug_line, "debug-line", SCRIPT_BOOL, "show a line for so many seconds",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_INT, SCRIPT_FLOAT))
SCRIPT_BINDING(debug_circle, "debug-circle", SCRIPT_BOOL, "show a circle for so many seconds",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_FLOAT, SCRIPT_INT, SCRIPT_FLOAT))
SCRIPT_BINDING(debug_rect, "debug-rect", SCRIPT_BOOL, "show a rectangle for so many seconds",
               (SCRIPT_NONE, SCRIPT_VECTOR2, SCRIPT_VECTOR2, SCRIPT_INT, SCRIPT_FLOAT))
SCRIPT_BINDING(debug_text, "debug-text", SCRIPT_BOOL, "show text for so many seconds",
               (SCRIPT_NONE, SCRIPT_STRING, SCRIPT_VECTOR2, SCRIPT_INT, SCRIPT_FLOAT))

// ---- networking
SCRIPT_BINDING(net_clock_now, "net-clock-now", SCRIPT_FLOAT,
               "monotonic seconds, usable with no window open", (SCRIPT_NONE))

