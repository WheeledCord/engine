SCRIPT_BINDING(entity_get_number, "entity-get", SCRIPT_FLOAT,
               "read a number field from a scripted entity", (SCRIPT_NONE, SCRIPT_ENTITY, SCRIPT_STRING))
SCRIPT_BINDING(entity_set_number, "entity-set-number!", SCRIPT_NONE,
               "write a number field on a scripted entity", (SCRIPT_NONE, SCRIPT_ENTITY, SCRIPT_STRING, SCRIPT_FLOAT))
SCRIPT_BINDING(entity_get_vector, "entity-get-vector", SCRIPT_VECTOR2,
               "read a vector field from a scripted entity", (SCRIPT_NONE, SCRIPT_ENTITY, SCRIPT_STRING))
SCRIPT_BINDING(entity_set_vector, "entity-set-vector!", SCRIPT_NONE,
               "write a vector field on a scripted entity", (SCRIPT_NONE, SCRIPT_ENTITY, SCRIPT_STRING, SCRIPT_VECTOR2))

// ---- the transform every scripted entity carries
SCRIPT_BINDING(position, "position", SCRIPT_VECTOR2, "where this entity is", (SCRIPT_NONE))
SCRIPT_BINDING(set_position, "set-position!", SCRIPT_NONE, "put this entity somewhere",
