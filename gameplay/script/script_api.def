SCRIPT_BINDING(classname, "classname", SCRIPT_STRING, "the class an entity was spawned from",
               (SCRIPT_NONE, SCRIPT_ENTITY))
SCRIPT_BINDING(find_first, "find-first", SCRIPT_ENTITY, "the first living entity of a class",
               (SCRIPT_NONE, SCRIPT_STRING))
SCRIPT_BINDING(find_next, "find-next", SCRIPT_ENTITY,
               "the next living entity of a class after an entity", (SCRIPT_NONE, SCRIPT_ENTITY, SCRIPT_STRING))
SCRIPT_BINDING(entity_position, "entity-position", SCRIPT_VECTOR2,
               "the position of a scripted entity", (SCRIPT_NONE, SCRIPT_ENTITY))
SCRIPT_BINDING(set_entity_position, "set-entity-position!", SCRIPT_NONE,
