CC ?= cc
AR ?= ar
BUILD := build/core
RLSRC := $(BUILD)/raylib/src
RLLIB := $(RLSRC)/libraylib.a
CORE_SRC := $(filter-out core/entry.c,$(wildcard core/*.c))
CORE_OBJ := $(patsubst core/%.c,$(BUILD)/%.o,$(CORE_SRC))
GAMEPLAY_SRC := $(wildcard gameplay/*.c)
GAMEPLAY_OBJ := $(patsubst gameplay/%.c,$(BUILD)/gameplay_%.o,$(GAMEPLAY_SRC))
SCRIPT_SRC := $(wildcard gameplay/script/*.c)
SCRIPT_OBJ := $(patsubst gameplay/%.c,$(BUILD)/gameplay_%.o,$(SCRIPT_SRC)) $(BUILD)/vendor/s7.o \
	$(BUILD)/vendor/amx.o $(BUILD)/vendor/amxaux.o $(BUILD)/vendor/amxfloat.o $(PAWN_VM_EXTRA)
CFLAGS := -std=c99 -O2 -g -Wall -Wextra -Wpedantic -Werror -DGRAPHICS_API_OPENGL_21
LDLIBS := -lm -lpthread -ldl -lGL -lX11
RAYLIB_CFLAGS := -DSUPPORT_FILEFORMAT_BDF
RAYLIB_REV := $(shell git -C raylib rev-parse HEAD 2>/dev/null)
.PHONY: sdk install sdk-example run-authoring all run smoke gameplay-smoke clean boundary FORCE
all: $(BUILD)/core_test $(BUILD)/gameplay_test $(BUILD)/regression_test projects/regression_test/tester.amx
# Re-export whenever the raylib checkout moves: the stamp only changes when the revision does, and
# the export is of that revision, so a submodule update cannot leave stale sources behind.
FORCE:
$(BUILD)/raylib.rev: FORCE
	@mkdir -p $(BUILD)
	@printf '%s' '$(RAYLIB_REV)' | cmp -s - $@ || printf '%s' '$(RAYLIB_REV)' > $@
$(RLSRC)/.exported: $(BUILD)/raylib.rev
	rm -rf $(BUILD)/raylib
	mkdir -p $(BUILD)/raylib
	git -C raylib archive HEAD src | tar -x -C $(BUILD)/raylib
	touch $@
$(RLLIB): $(RLSRC)/.exported Makefile.core
	$(MAKE) -C $(RLSRC) GRAPHICS=GRAPHICS_API_OPENGL_21 CUSTOM_CFLAGS='$(RAYLIB_CFLAGS)' -j4 > $(BUILD)/raylib-build.log 2>&1
boundary: $(RLSRC)/.exported
	python3 tools/check_core_dependencies.py --cc '$(CC)' --cflags '$(CFLAGS)' --raylib $(RLSRC)
$(BUILD)/%.o: core/%.c $(RLSRC)/.exported | boundary
	$(CC) $(CFLAGS) -I$(RLSRC) -MMD -MP -c $< -o $@
$(BUILD)/libcore.a: $(CORE_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(CORE_OBJ)
$(BUILD)/gameplay_%.o: gameplay/%.c $(RLSRC)/.exported | boundary
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -I. -I$(RLSRC) -Ivendor/s7 -Ivendor/pawn/amx -Ivendor/pawn/linux -DPAWN_CELL_SIZE=32 -MMD -MP -c $< -o $@
# Vendored interpreters are other people's code: they build under their own warning settings.
$(BUILD)/vendor/s7.o: vendor/s7/s7.c $(RLSRC)/.exported
	@mkdir -p $(@D)
	$(CC) -std=gnu11 -O2 -g -w -DWITH_SYSTEM_EXTRAS=0 -DWITH_C_LOADER=0 -c $< -o $@
# Pawn's assembly core is 32-bit x86 only; everywhere else runs its portable C VM. Override with
# PAWN_CORE=asm on a 32-bit build, which is rejected outright on anything the assembly cannot serve.
PAWN_CORE ?= $(if $(filter i%86,$(shell uname -m)),asm,c)
ifeq ($(PAWN_CORE),asm)
  ifeq ($(filter i%86,$(shell uname -m)),)
    $(error PAWN_CORE=asm needs a 32-bit x86 target; this is $(shell uname -m))
  endif
  PAWN_VM_FLAGS := -DAMX_ASM
  PAWN_VM_EXTRA := $(BUILD)/vendor/amxexec.o
else
  PAWN_VM_FLAGS :=
  PAWN_VM_EXTRA :=
endif
$(BUILD)/vendor/amx%.o: vendor/pawn/amx/amx%.c $(RLSRC)/.exported
	@mkdir -p $(@D)
	$(CC) -std=gnu99 -O2 -g -w -DPAWN_CELL_SIZE=32 $(PAWN_VM_FLAGS) -Ivendor/pawn/amx -Ivendor/pawn/linux -c $< -o $@
$(BUILD)/vendor/amx.o: vendor/pawn/amx/amx.c $(RLSRC)/.exported
	@mkdir -p $(@D)
	$(CC) -std=gnu99 -O2 -g -w -DPAWN_CELL_SIZE=32 $(PAWN_VM_FLAGS) -Ivendor/pawn/amx -Ivendor/pawn/linux -c $< -o $@
# The Pawn compiler, built as a tool of the build rather than something to install.
PAWNCC_SRC := $(wildcard vendor/pawn/compiler/sc[1-7].c) vendor/pawn/compiler/scexpand.c \
	vendor/pawn/compiler/sci18n.c vendor/pawn/compiler/sclist.c vendor/pawn/compiler/scmemfil.c \
	vendor/pawn/compiler/scstate.c vendor/pawn/compiler/scvars.c vendor/pawn/compiler/lstring.c \
	vendor/pawn/compiler/memfile.c vendor/pawn/amx/keeloq.c vendor/pawn/linux/binreloc.c
$(BUILD)/pawncc: $(PAWNCC_SRC)
	@mkdir -p $(@D)
	$(CC) -std=gnu99 -O2 -w -Wno-error=incompatible-pointer-types -Wno-error=implicit-function-declaration \
		-Wno-error=int-conversion -DLINUX -DENABLE_BINRELOC -DHAVE_STDINT_H \
		-Ivendor/pawn/compiler -Ivendor/pawn/amx -Ivendor/pawn/linux $^ -o $@ -lm
# A Pawn script is compiled against declarations written from the binding table, so the two cannot
# fall out of step.
$(BUILD)/engine.inc: $(BUILD)/pawn_include
	@mkdir -p $(@D)
	./$(BUILD)/pawn_include $@
%.amx: %.pwn $(BUILD)/pawncc $(BUILD)/engine.inc
	./$(BUILD)/pawncc -i$(BUILD) -ivendor/pawn/include -o$@ $<
$(BUILD)/libgameplay.a: $(GAMEPLAY_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(GAMEPLAY_OBJ)
$(BUILD)/libscript.a: $(SCRIPT_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(SCRIPT_OBJ)
# One declaration per project: name, core|gameplay, optional entry.
# Every projects/<name>/*.c is built; projects can keep a custom main by omitting entry.
define core_project
$(BUILD)/projects/$(1)/%.o: projects/$(1)/%.c $(RLSRC)/.exported | boundary
	mkdir -p $$(@D)
	$(CC) $(CFLAGS) -I. -I$(RLSRC) -MMD -MP -c $$< -o $$@
$(BUILD)/$(1): $(patsubst projects/$(1)/%.c,$(BUILD)/projects/$(1)/%.o,$(wildcard projects/$(1)/*.c)) $(if $(filter entry,$(3)),$(BUILD)/entry.o) $(if $(filter gameplay,$(2)),$(BUILD)/libscript.a $(BUILD)/libgameplay.a) $(BUILD)/libcore.a $(RLLIB) | boundary
	$(CC) $$^ $(LDLIBS) -o $$@
endef

$(eval $(call core_project,core_test,core))
$(eval $(call core_project,gameplay_test,gameplay))
$(eval $(call core_project,regression_test,gameplay))
$(eval $(call core_project,pawn_include,gameplay))

# ---- the SDK a project outside this repository builds against --------------------------------
# Everything a project needs and nothing of this repository's own layout: headers, static libraries,
# the runtime data the engine loads, the Pawn compiler and its declarations, and the tools that build
# a project. It is written somewhere of its own, never into a project's own directory.
SDK ?= $(BUILD)/sdk
PREFIX ?= $(HOME)/.local
SDK_HEADERS := $(filter-out core/ui_internal.h,$(wildcard core/*.h)) $(wildcard gameplay/*.h) \
	$(wildcard gameplay/script/*.h)
sdk: $(BUILD)/libcore.a $(BUILD)/libgameplay.a $(BUILD)/libscript.a $(RLLIB) $(BUILD)/pawncc $(BUILD)/engine.inc
	rm -rf $(SDK)
	mkdir -p $(SDK)/include/core $(SDK)/include/gameplay/script $(SDK)/lib/pkgconfig $(SDK)/bin \
		$(SDK)/share/engine/src $(SDK)/share/engine/pawn
	cp $(filter core/%,$(SDK_HEADERS)) $(SDK)/include/core/
	cp $(filter gameplay/%.h,$(SDK_HEADERS)) $(SDK)/include/gameplay/ 2>/dev/null || true
	cp gameplay/script/*.h gameplay/script/script_api.def $(SDK)/include/gameplay/script/
	cp $(RLSRC)/raylib.h $(RLSRC)/raymath.h $(RLSRC)/rlgl.h $(SDK)/include/
	cp $(BUILD)/libcore.a $(BUILD)/libgameplay.a $(BUILD)/libscript.a $(RLLIB) $(SDK)/lib/
	# In the tree this file sits beside engine.h; in an SDK it is included the way a project does.
	sed 's|#include "engine.h"|#include "core/engine.h"|' core/entry.c > $(SDK)/share/engine/src/entry.c
	cp -r core/fonts core/shaders $(SDK)/share/engine/
	cp $(BUILD)/engine.inc vendor/pawn/include/*.inc vendor/pawn/include/*.INC $(SDK)/share/engine/pawn/
	# pawncc lives beside its own includes, not in bin/: it works out where its standard includes
	# are from its own location, and from bin/ that search reaches include/core, a directory it
	# would open as though it were the core.inc it is looking for, and then read forever.
	cp $(BUILD)/pawncc $(SDK)/share/engine/pawn/
	cp tools/engine_build.py $(SDK)/bin/engine-build
	cp tools/engine_new.py $(SDK)/bin/engine-new
	chmod +x $(SDK)/bin/engine-build $(SDK)/bin/engine-new
	python3 tools/write_engine_pc.py --prefix "$(abspath $(SDK))" --out $(SDK)/lib/pkgconfig/engine.pc
	@echo "SDK in $(SDK); build a project with $(SDK)/bin/engine-build <project dir>"
# Installing is the same tree somewhere lasting, with the paths inside engine.pc pointing there.
install: sdk
	mkdir -p $(PREFIX)
	cp -r $(SDK)/include $(SDK)/lib $(SDK)/bin $(SDK)/share $(PREFIX)/
	python3 tools/write_engine_pc.py --prefix "$(abspath $(PREFIX))" --out $(PREFIX)/lib/pkgconfig/engine.pc
	@echo "Installed to $(PREFIX). PKG_CONFIG_PATH=$(PREFIX)/lib/pkgconfig"
# A project outside this repository, built the way any of them is. The games and the editor live
# in the workspace beside the engine, so this is where they are unless told otherwise.
WORKSPACE ?= ..
sdk-example: sdk
	$(SDK)/bin/engine-build $(WORKSPACE)/Games/authoring-demo --sdk $(SDK)

run-authoring: sdk
	$(SDK)/bin/engine-build $(WORKSPACE)/Games/authoring-demo --sdk $(SDK) --run
run: $(BUILD)/core_test
	./$(BUILD)/core_test
smoke: all
	./$(BUILD)/core_test --smoke
	./$(BUILD)/gameplay_test
	./$(BUILD)/regression_test
	./$(BUILD)/regression_test --runner
gameplay-smoke: $(BUILD)/gameplay_test
	./$(BUILD)/gameplay_test
clean:
	python3 -c 'import shutil; shutil.rmtree("$(BUILD)", ignore_errors=True)'
-include $(wildcard $(BUILD)/*.d $(BUILD)/projects/*/*.d)
