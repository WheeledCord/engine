CC ?= cc
AR ?= ar
BUILD := build/core
RLSRC := $(BUILD)/raylib/src
RLLIB := $(RLSRC)/libraylib.a
# entry.c is the standard main. It sits in libcore like everything else: the linker takes it only
# when a program has no main of its own.
CORE_SRC := $(wildcard core/*.c)
CORE_OBJ := $(patsubst core/%.c,$(BUILD)/%.o,$(CORE_SRC))
ENET_SRC := vendor/enet/callbacks.c vendor/enet/compress.c vendor/enet/host.c vendor/enet/list.c \
	vendor/enet/packet.c vendor/enet/peer.c vendor/enet/protocol.c vendor/enet/unix.c
ENET_OBJ := $(patsubst vendor/enet/%.c,$(BUILD)/vendor/enet_%.o,$(ENET_SRC))
GAMEPLAY_SRC := $(wildcard gameplay/*.c)
GAMEPLAY_OBJ := $(patsubst gameplay/%.c,$(BUILD)/gameplay_%.o,$(GAMEPLAY_SRC))
SCRIPT_SRC := $(wildcard gameplay/script/*.c)
SCRIPT_OBJ := $(patsubst gameplay/%.c,$(BUILD)/gameplay_%.o,$(SCRIPT_SRC)) $(BUILD)/vendor/s7.o
CFLAGS := -std=c99 -O2 -g -Wall -Wextra -Wpedantic -Werror -DGRAPHICS_API_OPENGL_21 \
	-Ivendor/enet/include
LDLIBS := -lm -lpthread -ldl -lGL -lX11
RAYLIB_CFLAGS := -DSUPPORT_FILEFORMAT_BDF
RAYLIB_REV := $(shell git -C raylib rev-parse HEAD 2>/dev/null)
# What the SDK says it is: the revision it was built from, and whether that tree had uncommitted
# changes, so a build can always be traced back to an engine someone can check out.
ENGINE_REV := $(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)$(shell git diff --quiet 2>/dev/null || echo -dirty)
.PHONY: sdk sdk-check install all run test-regression integration smoke full-check api-docs-update docs-check clean boundary hooks FORCE
# A normal build produces the engine and its authoring tools. Tests are opt-in commands below.
all: $(BUILD)/libcore.a $(BUILD)/libgameplay.a $(BUILD)/libscript.a
# Re-export whenever the raylib checkout moves: the stamp only changes when the revision does, and
# the export is of that revision, so a submodule update cannot leave stale sources behind.
FORCE:
$(BUILD)/raylib.rev: FORCE
	@mkdir -p $(BUILD)
	@printf '%s' '$(RAYLIB_REV)' | cmp -s - $@ || printf '%s' '$(RAYLIB_REV)' > $@
$(RLSRC)/.exported: $(BUILD)/raylib.rev
	rm -rf $(BUILD)/raylib
	mkdir -p $(BUILD)/raylib
	git -C raylib archive HEAD src | tar -x -C $(BUILD)/raylib
	touch $@
$(RLLIB): $(RLSRC)/.exported Makefile.core
	$(MAKE) -C $(RLSRC) GRAPHICS=GRAPHICS_API_OPENGL_21 CUSTOM_CFLAGS='$(RAYLIB_CFLAGS)' -j4 > $(BUILD)/raylib-build.log 2>&1
boundary: $(RLSRC)/.exported
	python3 tools/check_core_dependencies.py --cc '$(CC)' --cflags '$(CFLAGS)' --raylib $(RLSRC)
$(BUILD)/%.o: core/%.c $(RLSRC)/.exported | boundary
	$(CC) $(CFLAGS) -I$(RLSRC) -MMD -MP -c $< -o $@
$(BUILD)/vendor/enet_%.o: vendor/enet/%.c
	@mkdir -p $(@D)
	$(CC) -std=c99 -O2 -w -D_DEFAULT_SOURCE -Ivendor/enet/include -DHAS_SOCKLEN_T -DHAS_POLL -DHAS_FCNTL \
		-DHAS_INET_PTON -DHAS_INET_NTOP -DHAS_GETADDRINFO -DHAS_GETNAMEINFO \
		-c $< -o $@
$(BUILD)/libcore.a: $(CORE_OBJ) $(ENET_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(CORE_OBJ) $(ENET_OBJ)
$(BUILD)/gameplay_%.o: gameplay/%.c $(RLSRC)/.exported | boundary
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -I. -I$(RLSRC) -Ivendor/s7 -MMD -MP -c $< -o $@
# Vendored interpreters are other people's code: they build under their own warning settings.
$(BUILD)/vendor/s7.o: vendor/s7/s7.c $(RLSRC)/.exported
	@mkdir -p $(@D)
	$(CC) -std=gnu11 -O2 -g -w -DWITH_SYSTEM_EXTRAS=0 -DWITH_C_LOADER=0 -c $< -o $@
$(BUILD)/libgameplay.a: $(GAMEPLAY_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(GAMEPLAY_OBJ)
$(BUILD)/libscript.a: $(SCRIPT_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(SCRIPT_OBJ)
# One declaration per executable test: target name, source root. Every program links the whole
# engine, as a game does; the linker keeps only what it calls. Test sources deliberately live
# outside the engine's project-facing API.
define core_project
$(BUILD)/$(2)/%.o: $(2)/%.c $(RLSRC)/.exported | boundary
	mkdir -p $$(@D)
	$(CC) $(CFLAGS) -I. -I$(RLSRC) -MMD -MP -c $$< -o $$@
$(BUILD)/$(1): $(patsubst $(2)/%.c,$(BUILD)/$(2)/%.o,$(wildcard $(2)/*.c)) $(BUILD)/libscript.a $(BUILD)/libgameplay.a $(BUILD)/libcore.a $(RLLIB) | boundary
	$(CC) $$^ $$(LDLIBS) -o $$@
endef

$(eval $(call core_project,core_integration,tests/integration/core))
$(eval $(call core_project,regression_test,tests/regression))
# Go/no-go condition 6: the draw path timed headless through EGL, so it links EGL as well.
$(eval $(call core_project,draw_bench,tools/draw_bench))
$(BUILD)/draw_bench: LDLIBS += -lEGL
$(eval $(call core_project,store_bench,tools/store_bench))
$(eval $(call core_project,net_bench,tools/net_bench))
# The project runner (gameplay/game.c). The runner in libgameplay calls into libscript, which the
# default link order has already passed, so the libraries are listed once more after it.
$(eval $(call core_project,trench,tools/trench))
$(BUILD)/trench: LDLIBS := $(BUILD)/libscript.a $(BUILD)/libgameplay.a $(BUILD)/libcore.a $(RLLIB) $(LDLIBS)

# ---- the SDK a project outside this repository builds against --------------------------------
# Everything a project needs and nothing of this repository's own layout: headers, static libraries,
# the runtime data the engine loads, and the tools that build a project. It is written somewhere of
# its own, never into a project's own directory.
SDK ?= $(BUILD)/sdk
PREFIX ?= $(HOME)/.local
SDK_HEADERS := $(filter-out core/ui_internal.h,$(wildcard core/*.h)) $(wildcard gameplay/*.h) \
	$(wildcard gameplay/script/*.h)
sdk: $(BUILD)/libcore.a $(BUILD)/libgameplay.a $(BUILD)/libscript.a $(RLLIB) $(BUILD)/trench
	rm -rf $(SDK)
	mkdir -p $(SDK)/include/core $(SDK)/include/gameplay/script $(SDK)/lib/pkgconfig $(SDK)/bin \
		$(SDK)/share/engine
	cp $(filter core/%,$(SDK_HEADERS)) $(SDK)/include/core/
	cp $(filter gameplay/%.h,$(SDK_HEADERS)) $(SDK)/include/gameplay/ 2>/dev/null || true
	cp gameplay/script/*.h $(SDK)/include/gameplay/script/
	cp $(RLSRC)/raylib.h $(RLSRC)/raymath.h $(RLSRC)/rlgl.h $(SDK)/include/
	cp $(BUILD)/libcore.a $(BUILD)/libgameplay.a $(BUILD)/libscript.a $(RLLIB) $(SDK)/lib/
	cp -r core/fonts core/shaders core/scheme $(SDK)/share/engine/
	cp tools/engine_build.py $(SDK)/bin/engine-build
	cp tools/engine_new.py $(SDK)/bin/engine-new
	cp $(BUILD)/trench $(SDK)/bin/trench
	chmod +x $(SDK)/bin/engine-build $(SDK)/bin/engine-new
	python3 tools/write_engine_pc.py --prefix "$(abspath $(SDK))" --revision "$(ENGINE_REV)" --out $(SDK)/lib/pkgconfig/engine.pc
	@echo "SDK $(ENGINE_REV) in $(SDK); build a project with $(SDK)/bin/engine-build <project dir>"
# Installing is the same tree somewhere lasting, with the paths inside engine.pc pointing there.
install: sdk
	mkdir -p $(PREFIX)
	cp -r $(SDK)/include $(SDK)/lib $(SDK)/bin $(SDK)/share $(PREFIX)/
	python3 tools/write_engine_pc.py --prefix "$(abspath $(PREFIX))" --revision "$(ENGINE_REV)" --out $(PREFIX)/lib/pkgconfig/engine.pc
	@echo "Installed to $(PREFIX). PKG_CONFIG_PATH=$(PREFIX)/lib/pkgconfig"
run: $(BUILD)/core_integration
	./$(BUILD)/core_integration
test-regression: $(BUILD)/regression_test $(BUILD)/trench
	./$(BUILD)/regression_test
integration: $(BUILD)/core_integration
	./$(BUILD)/core_integration --smoke
# engine-build's contracts, engine-new's Scheme project under the build tree's trench, and the SDK's
# trench running that project from outside the engine tree.
sdk-check: sdk
	python3 tools/test_engine_build.py --sdk $(SDK)
smoke: test-regression sdk-check
	$(MAKE) -f Makefile.core docs-check
full-check: smoke integration
# The owner turns the commit gate on (docs/developer/hooks.md); it is not part of all.
hooks:
	git config core.hooksPath tools/hooks
api-docs-update:
	python3 tools/generate_api_docs.py --write
docs-check:
	python3 tools/generate_api_docs.py --check
	python3 tools/check_api_docs.py
clean:
	python3 -c 'import shutil; shutil.rmtree("$(BUILD)", ignore_errors=True)'
-include $(wildcard $(BUILD)/*.d $(BUILD)/*/*.d $(BUILD)/tests/*/*.d $(BUILD)/tests/*/*/*.d $(BUILD)/tools/*/*.d)
