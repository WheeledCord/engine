CC ?= cc
AR ?= ar
BUILD := build/core
RLSRC := $(BUILD)/raylib/src
RLLIB := $(RLSRC)/libraylib.a
CORE_SRC := $(filter-out core/entry.c,$(wildcard core/*.c))
CORE_OBJ := $(patsubst core/%.c,$(BUILD)/%.o,$(CORE_SRC))
GAMEPLAY_SRC := $(wildcard gameplay/*.c)
GAMEPLAY_OBJ := $(patsubst gameplay/%.c,$(BUILD)/gameplay_%.o,$(GAMEPLAY_SRC))
CFLAGS := -std=c99 -O2 -g -Wall -Wextra -Wpedantic -Werror -DGRAPHICS_API_OPENGL_21
LDLIBS := -lm -lpthread -ldl -lGL -lX11
RAYLIB_CFLAGS := -DSUPPORT_FILEFORMAT_BDF
RAYLIB_REV := $(shell git -C raylib rev-parse HEAD 2>/dev/null)
.PHONY: run-authoring all run run-ui-tool smoke gameplay-smoke clean boundary games run-3d run-2d FORCE
all: $(BUILD)/core_test $(BUILD)/gameplay_test $(BUILD)/ui_tool $(BUILD)/authoring_demo $(BUILD)/regression_test
games: $(BUILD)/game3d_collector $(BUILD)/game2d_dodge
# Re-export whenever the raylib checkout moves: the stamp only changes when the revision does, and
# the export is of that revision, so a submodule update cannot leave stale sources behind.
FORCE:
$(BUILD)/raylib.rev: FORCE
	@mkdir -p $(BUILD)
	@printf '%s' '$(RAYLIB_REV)' | cmp -s - $@ || printf '%s' '$(RAYLIB_REV)' > $@
$(RLSRC)/.exported: $(BUILD)/raylib.rev
	rm -rf $(BUILD)/raylib
	mkdir -p $(BUILD)/raylib
	git -C raylib archive HEAD src | tar -x -C $(BUILD)/raylib
	touch $@
$(RLLIB): $(RLSRC)/.exported Makefile.core
	$(MAKE) -C $(RLSRC) GRAPHICS=GRAPHICS_API_OPENGL_21 CUSTOM_CFLAGS='$(RAYLIB_CFLAGS)' -j4 > $(BUILD)/raylib-build.log 2>&1
boundary: $(RLSRC)/.exported
	python3 tools/check_core_dependencies.py --cc '$(CC)' --cflags '$(CFLAGS)' --raylib $(RLSRC)
$(BUILD)/%.o: core/%.c $(RLSRC)/.exported | boundary
	$(CC) $(CFLAGS) -I$(RLSRC) -MMD -MP -c $< -o $@
$(BUILD)/libcore.a: $(CORE_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(CORE_OBJ)
$(BUILD)/gameplay_%.o: gameplay/%.c $(RLSRC)/.exported | boundary
	$(CC) $(CFLAGS) -I. -I$(RLSRC) -MMD -MP -c $< -o $@
$(BUILD)/libgameplay.a: $(GAMEPLAY_OBJ) Makefile.core
	rm -f $@
	$(AR) rcs $@ $(GAMEPLAY_OBJ)
# One declaration per project: name, core|gameplay, optional entry.
# Every projects/<name>/*.c is built; projects can keep a custom main by omitting entry.
define core_project
$(BUILD)/projects/$(1)/%.o: projects/$(1)/%.c $(RLSRC)/.exported | boundary
	mkdir -p $$(@D)
	$(CC) $(CFLAGS) -I. -I$(RLSRC) -MMD -MP -c $$< -o $$@
$(BUILD)/$(1): $(patsubst projects/$(1)/%.c,$(BUILD)/projects/$(1)/%.o,$(wildcard projects/$(1)/*.c)) $(if $(filter entry,$(3)),$(BUILD)/entry.o) $(if $(filter gameplay,$(2)),$(BUILD)/libgameplay.a) $(BUILD)/libcore.a $(RLLIB) | boundary
	$(CC) $$^ $(LDLIBS) -o $$@
endef

$(eval $(call core_project,core_test,core))
$(eval $(call core_project,gameplay_test,gameplay))
$(eval $(call core_project,ui_tool,core))
$(eval $(call core_project,game3d_collector,core))
$(eval $(call core_project,game2d_dodge,core))
$(eval $(call core_project,authoring_demo,gameplay,entry))
$(eval $(call core_project,regression_test,gameplay))

run-authoring: $(BUILD)/authoring_demo
	./$(BUILD)/authoring_demo
run: $(BUILD)/core_test
	./$(BUILD)/core_test
run-ui-tool: $(BUILD)/ui_tool
	./$(BUILD)/ui_tool
run-3d: $(BUILD)/game3d_collector
	./$(BUILD)/game3d_collector
run-2d: $(BUILD)/game2d_dodge
	./$(BUILD)/game2d_dodge
smoke: all
	./$(BUILD)/core_test --smoke
	./$(BUILD)/gameplay_test
	./$(BUILD)/ui_tool --smoke
	./$(BUILD)/regression_test
	./$(BUILD)/regression_test --runner
gameplay-smoke: $(BUILD)/gameplay_test
	./$(BUILD)/gameplay_test
clean:
	python3 -c 'import shutil; shutil.rmtree("$(BUILD)", ignore_errors=True)'
-include $(wildcard $(BUILD)/*.d $(BUILD)/projects/*/*.d)
